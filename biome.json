{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "host/client_app/**",
      "modules/*/*/pages/**",
      "modules/*/*/components/**",
      "modules/*/*/hooks/**",
      "modules/*/*/utils/**",
      "tests/e2e/**",
      "!**/node_modules",
      "!**/dist",
      "!host/client_app/modules.generated.ts",
      "!host/client_app/modules.manifest.json"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
