# Environment: development | production
SM_ENVIRONMENT=development

# Secret key for session middleware. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# `make env` copies this file to .env and fills this (and the two below) in.
SM_SECRET_KEY=replace-me-with-a-generated-secret

# Signing keys for the users module's password-reset and verification tokens.
# Required in every environment but development/testing — the users module
# refuses to boot on its placeholders — and that includes the Docker stack,
# which runs SM_ENVIRONMENT=production (compose.yaml).
SM_USERS_RESET_PASSWORD_TOKEN_SECRET=replace-me-with-a-generated-secret
SM_USERS_VERIFICATION_TOKEN_SECRET=replace-me-with-a-generated-secret

# Database — SQLite by default. For Postgres (see CLAUDE.md "Local database") use:
#   postgresql+asyncpg://postgres:postgres@localhost:5432/smpy_modules
SM_DATABASE_URL=sqlite+aiosqlite:///./host/app.db

SM_MULTI_TENANT=false

# Vite dev server URL (development only).
SM_VITE_DEV_URL=http://localhost:5050

# The pagebuilder and news modules are NOT configured here. Their settings live
# in the database and are edited on the Settings screen — an SM_PAGEBUILDER_* or
# SM_NEWS_* line in this file is read by nothing. For a headless deployment:
#
#   python scripts/set_setting.py pagebuilder content_locales '["en","de"]'
#
# (SM_I18N_SUPPORTED_LOCALES below is a different thing: it is what language the
# *admin console* speaks, not what languages the site publishes in.)

# Languages the admin console speaks. Every module in this repo ships an English
# and a German catalogue, as do the console chrome and the framework modules' own
# screens (users, settings, …) since framework 0.0.38; host/locales/overrides
# rewords a few of the chrome's labels. The first entry is not special — the
# default is SM_I18N_DEFAULT_LOCALE (en).
SM_I18N_SUPPORTED_LOCALES=["en","de"]

# Optional: JSON array restricting which installed modules load at boot.
# SM_MODULES_ENABLED=["Auth","Users","PageBuilder"]

# First-boot admin seed. Only applied when the users table is empty.
# SM_USERS_BOOTSTRAP_EMAIL=admin@example.com
# SM_USERS_BOOTSTRAP_PASSWORD=choose-a-strong-one
